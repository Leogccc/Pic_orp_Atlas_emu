05D3:  MOVWF  3E
05D4:  MOVF   77,W
05D5:  MOVWF  3D
....................   #endif 
....................  
....................   #if MCP3421_GAIN == MCP3421_8X_GAIN 
....................    fresult /= 8; 
....................   #elif MCP3421_GAIN == MCP3421_4X_GAIN 
....................    fresult /= 4; 
....................   #elif MCP3421_gain == MCP3421_2X_GAIN 
....................    fresult /= 2; 
....................   #endif 
....................  
....................    return(fresult); 
