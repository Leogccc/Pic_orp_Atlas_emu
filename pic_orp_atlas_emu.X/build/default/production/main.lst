.................... void ANPH_L(void){ 
.................... /* Comando sintaxe 
....................  L,1 // LED on ; Response: 1(DEC) 0(NULL) 
....................  L,0  //  LED off ; Response: 1(DEC) 0(NULL) 
....................  L,? // LED state on/off? ; Response: 1(DEC) ?L,1 0(NULL) ou 1(DEC) ?L,0 0(NULL) 
