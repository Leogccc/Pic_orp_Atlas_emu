....................  
....................  #pin_select SCL2IN = MCP3421_SCL  
....................  #pin_select SCL2OUT = MCP3421_SCL 
....................  #pin_select SDA2IN = MCP3421_SDA 
....................  #pin_select SDA2OUT = MCP3421_SDA 
