0135:  RLF    6A,W
0136:  IORLW  D0
0137:  MOVWF  6B
0138:  MOVLB  03
0139:  MOVWF  3F
013A:  MOVLB  00
013B:  CALL   0F8
....................   i2c_write(MCP3421_STREAM, MCP3421_MODE | MCP3421_BITS | MCP3421_GAIN);  //send device configuration 
013C:  MOVLW  1C
013D:  MOVLB  03
013E:  MOVWF  3F
013F:  MOVLB  00
0140:  CALL   0F8
....................   i2c_stop(MCP3421_STREAM);  //send I2C stop 
