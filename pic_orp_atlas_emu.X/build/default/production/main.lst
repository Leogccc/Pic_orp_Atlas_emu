.................... */ 
....................  
.................... #INT_SSP // interrupcao I2C1 ( dispara a cada dado recebido ou dado enviado por SSP, chamando SSP_isr_slave ) 
.................... void SSP_isr_slave(void) // ISR associado a interrupcao INT_SSP  
.................... { 
....................  
....................      
....................    unsigned int8 state; 
....................    state = i2c_isr_state(I2C_PIC_SLAVE); 
