.................... //CWG1MD = 0 ;   //bit 6 CWG1MD: Disable CWG1 bit 
.................... //PWM6MD = 0 ;     //bit 5 PWM6MD: Disable PWM6 bit 
.................... //PWM5MD = 0 ;    //bit 4 PWM5MD: Disable PWM5 bit 
.................... //CCP4MD = 0 ;     //bit 3 CCP4MD: Disable CCP4 bit 
