....................  
.................... // NCOMD = 0;  //bit 7 NCOMD: Disable Numerically Control Oscillator bit 
.................... //TMR6MD=  0  ; //bit 6 TMR6MD: Disable Timer TMR6 bit 
.................... //TMR5MD = 0 ; //bit 5 TMR5MD: Disable Timer TMR5 bit 
