....................    i2c_write(MCP3421_STREAM, MCP3421_START_CONVERSTION | MCP3421_MODE | MCP3421_BITS | MCP3421_GAIN);  //initiate conversion 
....................    i2c_stop(MCP3421_STREAM);  //send I2C stop 
....................   #endif 
