....................  restart_wdt=> Restart the WDT while waiting in I2C_READ  
....................  */  
.................... #use i2c(SLAVE, I2C1, address= PIC_ADDRESS , stream= I2C_PIC_SLAVE, NOINIT,FORCE_HW, restart_wdt)  
*
0075:  MOVF   2B,W
0076:  MOVWF  11
0077:  BSF    15.4
0078:  MOVLB  00
0079:  BCF    11.3
007A:  MOVLB  04
007B:  BTFSC  14.0
007C:  GOTO   07B
007D:  CLRF   78
007E:  BTFSS  16.6
007F:  INCF   78,F
