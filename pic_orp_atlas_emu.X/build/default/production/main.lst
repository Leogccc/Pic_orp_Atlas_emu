.................... // Funções de comunicação com o MCP3421 
.................... #ifndef debug  
....................  
.................... ////////////////////////////////////////////////////////////////////////////////// 
.................... // adc_init() 
.................... // Purpose: To initialize the MCP3421. 
.................... // Parameters: address - Optional parameter for specifying the address of the 
.................... //                       MCP3421 to initialize.  Allows for initializing multiple 
.................... //                       devices on same bus.  Driver only supports one device 
.................... //                       configuration.  Defaults to MCP3421_ADDRESS if not 
.................... //                       specified. 
.................... // Returns:    Nothing. 
.................... ////////////////////////////////////////////////////////////////////////////////// 
....................  
.................... void adc_init(unsigned int8 address=MCP3421_ADDRESS) 
.................... { 
....................   i2c_start(MCP3421_STREAM);  //send I2C start 
*
00B2:  MOVLB  04
00B3:  BSF    1E.0
00B4:  BTFSC  1E.0
00B5:  GOTO   0B4
....................   i2c_write(MCP3421_STREAM, MCP3421_DEVICE_CODE | (address << 1));  //send write command 
00B6:  BCF    03.0
00B7:  MOVLB  03
00B8:  RLF    38,W
00B9:  IORLW  D0
00BA:  MOVWF  39
00BB:  MOVWF  4B
00BC:  MOVLB  00
00BD:  CALL   07E
....................   i2c_write(MCP3421_STREAM, MCP3421_MODE | MCP3421_BITS | MCP3421_GAIN);  //send device configuration 
00BE:  MOVLW  1C
00BF:  MOVLB  03
00C0:  MOVWF  4B
00C1:  MOVLB  00
00C2:  CALL   07E
....................   i2c_stop(MCP3421_STREAM);  //send I2C stop 
00C3:  MOVLB  04
00C4:  BSF    1E.2
00C5:  BTFSC  1E.2
00C6:  GOTO   0C5
.................... } 
....................  
.................... ////////////////////////////////////////////////////////////////////////////////// 
.................... // read_adc_mcp3421() 
.................... // Purpose: To read the last adc conversion from device, raw value read from 
.................... //          device. If device configured for One-Shot mode, it will initiate the 
.................... //          conversion.  Function will wait for a new conversion before returning. 
.................... // Parameter: address - Optional parameter for specifying the address of the 
.................... //                      MCP3421 to read.  Allows for reading multiple devices on 
.................... //                      same bus.  Defaults to MCP3421_ADDRESS if not specified. 
.................... // Returns:   signed int32 or signed int16 value depending MCP3421_BITS value. 
.................... ////////////////////////////////////////////////////////////////////////////////// 
.................... #if MCP3421_BITS == MCP3421_18BITS 
.................... signed int32 read_adc_mcp3421(unsigned int8 address=MCP3421_ADDRESS) 
.................... #else 
*
04FE:  MOVLW  80
04FF:  MOVWF  49
.................... signed int16 read_adc_mcp3421(unsigned int8 address=MCP3421_ADDRESS) 
.................... #endif 
.................... { 
....................   union 
....................   { 
....................    #if MCP3421_BITS == MCP3421_18BITS 
....................     signed int32 sint32; 
....................     unsigned int8 b[4]; 
....................    #else 
....................     signed int16 sint16; 
....................     unsigned int8 b[2]; 
....................    #endif 
....................   } result; 
....................   unsigned int8 status = 0x80; 
....................  
....................   #if MCP3421_MODE == MCP3421_ONE_SHOT 
....................    i2c_start(MCP3421_STREAM);  //send I2C start 
....................    i2c_write(MCP3421_STREAM, MCP3421_DEVICE_CODE | (address << 1));  //send write command 
....................    i2c_write(MCP3421_STREAM, MCP3421_START_CONVERSTION | MCP3421_MODE | MCP3421_BITS | MCP3421_GAIN);  //initiate conversion 
....................    i2c_stop(MCP3421_STREAM);  //send I2C stop 
....................   #endif 
....................  
....................    i2c_start(MCP3421_STREAM);  //send I2C start 
0500:  MOVLB  04
0501:  BSF    1E.0
0502:  BTFSC  1E.0
0503:  GOTO   502
....................    i2c_write(MCP3421_STREAM, MCP3421_DEVICE_CODE | (address << 1) | 1);  //send read command 
0504:  BCF    03.0
0505:  MOVLB  03
0506:  RLF    44,W
0507:  IORLW  D0
0508:  IORLW  01
0509:  MOVWF  4A
050A:  MOVWF  4B
050B:  MOVLB  00
050C:  CALL   07E
....................  
....................   #if MCP3421_BITS == MCP3421_18BITS 
....................    result.b[2] = i2c_read(MCP3421_STREAM, 1);  //read MSB 18 Bit mode 
050D:  MOVLW  01
050E:  MOVWF  77
050F:  CALL   2CF
0510:  MOVF   78,W
0511:  MOVLB  03
0512:  MOVWF  47
....................   #endif 
....................    result.b[1] = i2c_read(MCP3421_STREAM, 1);  //read 2nd MSB 18 Bit mode, read MSB 16, 14 or 12 Bit mode 
0513:  MOVLW  01
0514:  MOVWF  77
0515:  MOVLB  00
0516:  CALL   2CF
0517:  MOVF   78,W
0518:  MOVLB  03
0519:  MOVWF  46
....................    result.b[0] = i2c_read(MCP3421_STREAM, 1);  //read LSB 
051A:  MOVLW  01
051B:  MOVWF  77
051C:  MOVLB  00
051D:  CALL   2CF
051E:  MOVF   78,W
051F:  MOVLB  03
0520:  MOVWF  45
....................    status = i2c_read(MCP3421_STREAM, 1);       //read Status 
0521:  MOVLW  01
0522:  MOVWF  77
0523:  MOVLB  00
0524:  CALL   2CF
0525:  MOVF   78,W
0526:  MOVLB  03
0527:  MOVWF  49
....................  
....................    if(bit_test(status,7))  //if RDY = 1, New conversion not ready 
0528:  BTFSS  49.7
0529:  GOTO   55D
....................    { 
....................      do 
....................      { 
....................        status = i2c_read(MCP3421_STREAM, 1);  //read Status 
052A:  MOVLW  01
052B:  MOVWF  77
052C:  MOVLB  00
052D:  CALL   2CF
052E:  MOVF   78,W
052F:  MOVLB  03
0530:  MOVWF  49
....................      } while(bit_test(status, 7)); //until RDY = 0 
0531:  BTFSC  49.7
0532:  GOTO   52A
....................  
....................      status = i2c_read(MCP3421_STREAM, 0);  //read Status, do nack 
0533:  CLRF   77
0534:  MOVLB  00
0535:  CALL   2CF
0536:  MOVF   78,W
0537:  MOVLB  03
0538:  MOVWF  49
....................      i2c_stop();  //send I2C stop 
0539:  MOVLB  04
053A:  BSF    1E.2
053B:  BTFSC  1E.2
053C:  GOTO   53B
....................  
....................      i2c_start(MCP3421_STREAM);  //send I2C start 
053D:  BSF    1E.0
053E:  BTFSC  1E.0
053F:  GOTO   53E
....................      i2c_write(MCP3421_STREAM, MCP3421_DEVICE_CODE | (address << 1) | 1);  //send read command 
0540:  BCF    03.0
0541:  MOVLB  03
0542:  RLF    44,W
0543:  IORLW  D0
0544:  IORLW  01
0545:  MOVWF  4A
0546:  MOVWF  4B
0547:  MOVLB  00
0548:  CALL   07E
....................  
....................     #if MCP3421_BITS == MCP3421_18BITS 
....................      result.b[2] = i2c_read(MCP3421_STREAM, 1);  //read MSB 18 Bit mode 
0549:  MOVLW  01
054A:  MOVWF  77
054B:  CALL   2CF
054C:  MOVF   78,W
054D:  MOVLB  03
054E:  MOVWF  47
....................     #endif 
....................      result.b[1] = i2c_read(MCP3421_STREAM, 1);  //read 2nd MSB 18 Bit mode, read MSB 16, 14 or 12 Bit mode 
054F:  MOVLW  01
0550:  MOVWF  77
0551:  MOVLB  00
0552:  CALL   2CF
0553:  MOVF   78,W
0554:  MOVLB  03
0555:  MOVWF  46
....................      result.b[0] = i2c_read(MCP3421_STREAM, 1);  //read LSB 
0556:  MOVLW  01
0557:  MOVWF  77
0558:  MOVLB  00
0559:  CALL   2CF
055A:  MOVF   78,W
055B:  MOVLB  03
055C:  MOVWF  45
....................    } 
....................  
....................    status = i2c_read(MCP3421_STREAM, 0);  //read Status, do nack 
055D:  CLRF   77
055E:  MOVLB  00
055F:  CALL   2CF
0560:  MOVF   78,W
0561:  MOVLB  03
0562:  MOVWF  49
....................    i2c_stop();  //send I2C stop 
0563:  MOVLB  04
0564:  BSF    1E.2
0565:  BTFSC  1E.2
0566:  GOTO   565
....................  
....................   #if MCP3421_BITS == MCP3421_18BITS 
....................    if(bit_test(result.b[2],1))  //if 18 Bit mode check sign bit 
0567:  MOVLB  03
0568:  BTFSS  47.1
0569:  GOTO   56D
....................      result.b[3] = 0xFF; 
056A:  MOVLW  FF
056B:  MOVWF  48
056C:  GOTO   56E
....................    else 
....................      result.b[3] = 0; 
056D:  CLRF   48
....................   #endif 
....................  
....................   #if MCP3421_BITS == MCP3421_18BITS 
....................    return(result.sint32); 
056E:  MOVF   45,W
056F:  MOVWF  77
0570:  MOVF   46,W
0571:  MOVWF  78
0572:  MOVF   47,W
0573:  MOVWF  79
0574:  MOVF   48,W
0575:  MOVWF  7A
....................   #else 
....................    return(result.sint16); 
....................   #endif 
.................... } 
